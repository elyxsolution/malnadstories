# ─────────────────────────────────────────────────────────────────────────────
# Worker V2 — environment template
#
# Copy to `worker/.env` (git-ignored) and fill in, OR put the shared values in the
# repo-root `.env.local` that the Next.js app already uses. Both are loaded.
#
#   cp worker/.env.example worker/.env
#
# LOAD ORDER (nearest wins; the real environment always wins):
#
#   process.env  >  ./.env.local  >  ./.env  >  ../.env.local  >  ../.env  >  … upward
#
# Anything already exported — or injected by Render/Docker — is NEVER overridden by a
# file, so this is safe to leave in place in every environment.
#
# NO SECRETS IN THIS FILE. Placeholders only.
# ─────────────────────────────────────────────────────────────────────────────


# ══ INFRASTRUCTURE ═══════════════════════════════════════════════════════════
# THE MASTER SWITCH. Without it the worker starts, reports itself healthy, and
# processes nothing — it runs the in-memory "reference" worker instead.
# If you take one thing from this file, take this line.
#
# Accepts: on | true | 1 | yes     (off | false | 0 | no to disable)
# Default: off
WV2_INFRA=on


# ══ DATABASE ═════════════════════════════════════════════════════════════════
# Required when WV2_INFRA is on.
#
# Postgres SESSION connection — port 5432, NOT the 6543 transaction pooler
# (pg-boss cannot run on the transaction pooler). Same value the app uses; keep
# it in the repo-root .env.local so there is one copy of the secret.
#
# Used for: the pg-boss job queue AND the worker's database adapter.
DIRECT_URL=postgresql://postgres:PASSWORD@HOST.pooler.supabase.com:5432/postgres

# Optional. Max pooled connections this worker holds. Range 1–100, default 5.
# Each worker holds up to this many; check your Supabase plan before scaling out.
# WV2_DB_MAX_CONNECTIONS=5

# NOTE: SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are NOT used by the worker. It
# talks to Postgres directly over DIRECT_URL, not through the Supabase JS client.


# ══ CLOUDFLARE R2 ════════════════════════════════════════════════════════════
# All required when WV2_INFRA is on. Must be the SAME bucket the app uploads to.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# Optional. R2 ignores region but the S3 SDK requires a value. Default: auto
# R2_REGION=auto


# ══ APPLICATION ══════════════════════════════════════════════════════════════
# The origin Chromium loads the album print route from. A wrong value here breaks
# every PDF and nothing else. Validated as an absolute http(s) URL at startup.
# Default: http://localhost:3000
APP_URL=http://localhost:3000

# Port for the /health endpoint (Render injects this automatically).
# Unset = headless: the worker runs but exposes no health endpoint.
PORT=8080


# ══ WORKER ═══════════════════════════════════════════════════════════════════
# All optional — the defaults are the recommended production values.
# See worker/ops/CONFIGURATION.md for the reasoning behind each one.

# Concurrency lanes. Defaults assume a ~2GB instance.
# WV2_MAX_IN_FLIGHT=4          # global ceiling across all job types
# WV2_IMAGE_CONCURRENCY=3      # image hardening is I/O-bound, parallelises well
# WV2_PDF_CONCURRENCY=1        # a render owns a Chromium page — memory-dominant
# WV2_CLEANUP_CONCURRENCY=2

# Memory backpressure. Above soft: concurrency halves. Above hard: intake stops
# and in-flight work finishes (which is what releases the memory).
# WV2_MEMORY_SOFT_LIMIT_MB=768
# WV2_MEMORY_HARD_LIMIT_MB=1536

# Graceful shutdown budget. Keep BELOW your platform's SIGKILL grace period.
# WV2_DRAIN_TIMEOUT_MS=30000

# Idle poll interval. The loop wakes early when a job finishes, so this only
# affects a fully idle worker.
# WV2_POLL_INTERVAL_MS=1000

# Self-healing sweep. Leave enabled — it is what makes stuck work self-correcting.
# WV2_RECOVERY=on
# WV2_RECOVERY_INTERVAL_MS=60000
# WV2_RECOVERY_BATCH=100

# Runtime's own journal storage. NOT needed for image/PDF/cleanup work (that
# durability lives in pg-boss and R2). `memory` avoids needing a Render disk.
# If set to `filesystem`, WV2_STORAGE_ROOT must be WRITABLE — the runtime-storage
# health probe is liveness-critical and round-trips through it.
# WV2_STORAGE=memory
# WV2_STORAGE_ROOT=/data


# ══ OBSERVABILITY ════════════════════════════════════════════════════════════
# All optional.

# console = readable banner + lines for local dev. json = production log shipping.
# Default: json
WV2_LOG_FORMAT=console

# trace | debug | info | warn | error | fatal    Default: info
# WV2_LOG_LEVEL=info

# WV2_METRICS=on
# WV2_TRACING=on
# WV2_TRACE_SAMPLE=1           # 0..1; whole traces are kept or dropped, never half

# Guards /diagnostics and the detailed /ready payload. UNSET = /diagnostics is
# DISABLED (404) and /ready is redacted. The health port is publicly reachable,
# so detail is opt-in. Use a long random string.
# WV2_DIAGNOSTICS_TOKEN=

# Identifies this process in every log line. Defaults to the hostname.
# WV2_WORKER_ID=
