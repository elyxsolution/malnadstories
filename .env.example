NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Transaction pooler — for runtime Drizzle queries (serverless-safe)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler — for drizzle-kit migrations
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-region.pooler.supabase.com:5432/postgres

# Razorpay (TEST mode). key_secret + webhook secret are SERVER-ONLY — never NEXT_PUBLIC.
# key_id is non-sensitive; it is handed to the client per-order by the createOrder action.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-test-key-secret
# Set this to the same secret you configure on the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
