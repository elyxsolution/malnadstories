NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Transaction pooler — for runtime Drizzle queries (serverless-safe)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler — for drizzle-kit migrations
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-region.pooler.supabase.com:5432/postgres

# Razorpay. key_secret + webhook secret are SERVER-ONLY — never NEXT_PUBLIC and never
# committed. Put real values ONLY in .env.local (gitignored) or the host secret store.
# key_id is non-sensitive; it is handed to the client per-order by the createOrder action.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Must match the secret configured on the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Email (Resend). Sender/support/admin addresses come ONLY from these vars — never
# hardcoded — so switching the temporary Resend sender for orders@malnadstories.com
# later needs NO code change. If RESEND_API_KEY or EMAIL_FROM is unset, email is
# gracefully disabled (sends are skipped + logged; checkout/fulfillment still work).
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Malnad Stories <malnadstoriess@gmail.com>
SUPPORT_EMAIL=malnadstoriess@gmail.com
ADMIN_EMAIL=malnadstoriess@gmail.com
# Public base URL used to build links in emails + the password-reset redirect.
NEXT_PUBLIC_SITE_URL=https://malnadstories.vercel.app/

# Worker availability (Phase G). Public base URL of the SEPARATE worker service
# (Render). SERVER-ONLY — never NEXT_PUBLIC: the app probes WORKER_URL/health from the
# server so the worker URL never reaches the browser. If unset, worker gating is
# disabled (probes report "ready") — fine for local dev where the worker shares the
# machine. In prod, point this at the worker's Render URL.
WORKER_URL=http://localhost:8080
